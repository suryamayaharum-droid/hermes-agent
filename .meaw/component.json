{
  "schema": "meaw.component/v1",
  "name": "hermes-agent",
  "repository": "suryamayaharum-droid/hermes-agent",
  "role": "learning-agent-runtime",
  "capabilities": [
    "agent-memory",
    "agent-runtime",
    "mcp-client",
    "parallel-subagents",
    "scheduled-automation",
    "self-improving-skills"
  ],
  "interfaces": {
    "cli": "hermes",
    "mcp_client": true
  },
  "memory": {
    "mode": "bridge",
    "backend": "hermes-memory",
    "authority": false
  },
  "health": [
    {"type": "command", "argv": ["hermes", "doctor"]}
  ],
  "lifecycle": "active",
  "trust": "owned-fork",
  "priority": 70,
  "metadata": {
    "ecosystem": "MEAW",
    "integration": "learning-worker",
    "openclaw_migration": true,
    "discovery_executes_commands": false
  }
}
